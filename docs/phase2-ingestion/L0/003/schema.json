{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "L0_003_Gold_ETF_Holdings_Observation",
  "type": "object",
  "required": [
    "observation_date",
    "region",
    "holdings_tonnes",
    "unit",
    "source_citation",
    "source_file",
    "publication_date",
    "download_date",
    "ingestion_timestamp",
    "parser_version",
    "revision_metadata",
    "validation_status",
    "availability_status"
  ],
  "properties": {
    "observation_date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
      "description": "Observation date in YYYY-MM-DD format"
    },
    "region": {
      "type": "string",
      "description": "Geographic region or aggregated scope (e.g. GLOBAL)"
    },
    "holdings_tonnes": {
      "type": "number",
      "minimum": 0,
      "description": "Physical gold ETF holdings in metric tonnes"
    },
    "aum_usd_bn": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0,
      "description": "Assets Under Management in USD billions (optional/nullable)"
    },
    "unit": {
      "type": "string",
      "enum": [
        "metric_tonnes"
      ],
      "description": "Measurement unit for holdings"
    },
    "source_citation": {
      "type": "string",
      "description": "Data publisher citation"
    },
    "source_file": {
      "type": "string",
      "description": "Source filename parsed"
    },
    "publication_date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
      "description": "Publisher release date"
    },
    "download_date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
      "description": "File acquisition date"
    },
    "ingestion_timestamp": {
      "type": "string",
      "description": "ISO-8601 UTC timestamp of execution"
    },
    "parser_version": {
      "type": "string",
      "description": "Version identifier of the parsing module"
    },
    "revision_metadata": {
      "type": "object",
      "required": [
        "is_revision",
        "prior_value",
        "revision_reason"
      ],
      "properties": {
        "is_revision": {
          "type": "boolean"
        },
        "prior_value": {
          "type": [
            "number",
            "null"
          ]
        },
        "revision_reason": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "validation_status": {
      "type": "string",
      "enum": [
        "PASS",
        "FLAG"
      ],
      "description": "Quality check outcome"
    },
    "availability_status": {
      "type": "string",
      "enum": [
        "AVAILABLE",
        "STALE"
      ],
      "description": "Data freshness state"
    }
  },
  "additionalProperties": false
}
