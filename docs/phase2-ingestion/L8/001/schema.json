{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "L8-001 Gold ETF Net Flows",
  "type": "object",
  "required": ["variable_id", "observation_date", "etf_flow_tonnes", "unit", "source_file", "workbook_sha256", "validation_status", "availability_status"],
  "properties": {
    "variable_id": {"const": "L8-001"},
    "observation_date": {"type": "string", "format": "date"},
    "etf_flow_tonnes": {"type": "number"},
    "unit": {"const": "metric_tonnes"},
    "source_file": {"type": "string"},
    "source_publication_date": {"type": "string", "format": "date"},
    "download_date": {"type": "string", "format": "date"},
    "workbook_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "ingested_at": {"type": "string", "format": "date-time"},
    "validation_status": {"enum": ["PASS", "FLAG", "FAIL"]},
    "availability_status": {"enum": ["AVAILABLE", "STALE", "BLOCKED"]},
    "parser_version": {"type": "string"}
  }
}
