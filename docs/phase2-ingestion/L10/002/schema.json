{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "L10-002 COMEX Gold Open Interest",
  "type": "object",
  "required": [
    "variable_id",
    "observation_date",
    "product",
    "open_interest_contracts",
    "unit",
    "source_series_id",
    "source_manifest",
    "validation_status",
    "availability_status"
  ],
  "properties": {
    "variable_id": {
      "const": "L10-002"
    },
    "observation_date": {
      "type": "string",
      "format": "date"
    },
    "product": {
      "const": "COMEX GOLD"
    },
    "open_interest_contracts": {
      "type": "integer",
      "minimum": 0
    },
    "unit": {
      "const": "contracts"
    },
    "source_series_id": {
      "const": "COMEX_GOLD"
    },
    "source_manifest": {
      "type": "string",
      "minLength": 1
    },
    "validation_status": {
      "enum": [
        "PASS",
        "FLAG"
      ]
    },
    "availability_status": {
      "enum": [
        "AVAILABLE",
        "STALE"
      ]
    }
  }
}
