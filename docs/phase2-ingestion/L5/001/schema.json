{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "L5-001 Official Gold Purchase Changes",
  "type": "object",
  "required": [
    "variable_id",
    "observation_date",
    "official_purchase_change_tonnes",
    "unit",
    "validation_status",
    "availability_status"
  ],
  "properties": {
    "variable_id": {
      "const": "L5-001"
    },
    "observation_date": {
      "type": "string",
      "format": "date"
    },
    "official_purchase_change_tonnes": {
      "type": "number"
    },
    "unit": {
      "const": "metric_tonnes"
    },
    "source_file": {
      "type": "string"
    },
    "source_publication_date": {
      "type": "string",
      "format": "date"
    },
    "download_date": {
      "type": "string",
      "format": "date"
    },
    "ingested_at": {
      "type": "string",
      "format": "date-time"
    },
    "validation_status": {
      "enum": [
        "PASS",
        "FLAG",
        "FAIL"
      ]
    },
    "availability_status": {
      "enum": [
        "AVAILABLE",
        "STALE",
        "BLOCKED"
      ]
    },
    "parser_version": {
      "type": "string"
    }
  }
}
