{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "L5-003 Reserve Composition Change",
  "type": "object",
  "additionalProperties": false,
  "required": ["variable_id", "observation_date", "usd_reserve_share_pct", "usd_share_change_qoq_pp", "unit", "source_name", "source_dataset_id", "source_series_id", "raw_path", "raw_sha256", "manifest_path", "manifest_sha256", "retrieved_at", "validation_status", "availability_status", "fallback_checked_at", "parser_version"],
  "properties": {
    "variable_id": {"const": "L5-003"},
    "observation_date": {"type": "string", "format": "date"},
    "usd_reserve_share_pct": {"type": "number", "minimum": 0, "maximum": 100},
    "usd_share_change_qoq_pp": {"type": ["number", "null"]},
    "unit": {"const": "percent_and_percentage_points"},
    "source_name": {"const": "IMF COFER"},
    "source_dataset_id": {"const": "IMF.STA:COFER"},
    "source_series_id": {"const": "G001.AFXRA.CI_USD.SHRO_PT.Q"},
    "raw_path": {"type": "string", "minLength": 1},
    "raw_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "manifest_path": {"type": "string", "minLength": 1},
    "manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "retrieved_at": {"type": "string", "format": "date-time"},
    "validation_status": {"enum": ["PASS", "FLAG"]},
    "availability_status": {"enum": ["AVAILABLE", "STALE"]},
    "fallback_checked_at": {"type": ["string", "null"], "format": "date-time"},
    "parser_version": {"type": "string", "minLength": 1}
  }
}

