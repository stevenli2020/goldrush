{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "L9-004 India physical demand and imports",
  "type": "object",
  "required": [
    "variable_id",
    "observation_period",
    "observation_period_type",
    "observation_date",
    "component",
    "value",
    "unit",
    "validation_status",
    "availability_status"
  ],
  "properties": {
    "variable_id": {
      "const": "L9-004"
    },
    "observation_period": {
      "type": "string",
      "pattern": "^(20[0-9]{2}|Q[1-4]'[0-9]{2})$"
    },
    "observation_period_type": {
      "enum": [
        "annual",
        "quarterly"
      ]
    },
    "observation_date": {
      "type": "string",
      "format": "date"
    },
    "component": {
      "enum": [
        "jewellery_demand_tonnes",
        "bar_and_coin_demand_tonnes",
        "gross_bullion_imports_tonnes",
        "net_bullion_imports_tonnes"
      ]
    },
    "value": {
      "type": "number"
    },
    "unit": {
      "const": "metric_tonnes"
    },
    "value_definition": {
      "type": "string"
    },
    "source_workbook": {
      "type": "string"
    },
    "raw_file_path": {
      "type": "string"
    },
    "manifest_path": {
      "type": "string"
    },
    "retrieved_at": {
      "type": "string",
      "format": "date-time"
    },
    "publication_date": {
      "type": "string"
    },
    "download_date": {
      "type": "string"
    },
    "validation_status": {
      "enum": [
        "PASS",
        "FLAG",
        "FAIL"
      ]
    },
    "availability_status": {
      "enum": [
        "AVAILABLE",
        "STALE",
        "BLOCKED"
      ]
    },
    "parser_version": {
      "type": "string"
    }
  }
}
