{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "L1-006 Expected Policy Rate",
  "type": "object",
  "required": [
    "variable_id",
    "observation_date",
    "value",
    "unit",
    "source_name",
    "source_url",
    "source_series_id",
    "retrieved_at",
    "formula_version",
    "parser_version",
    "validation_status",
    "availability_status"
  ],
  "properties": {
    "variable_id": {
      "const": "L1-006"
    },
    "observation_date": {
      "type": "string",
      "format": "date"
    },
    "value": {
      "type": "number"
    },
    "unit": {
      "const": "percent_per_annum"
    },
    "source_name": {
      "type": "string"
    },
    "source_url": {
      "type": "string",
      "format": "uri"
    },
    "source_series_id": {
      "type": "string",
      "pattern": "^ZQ[A-Z]\\d{2}$"
    },
    "settlement_price": {
      "type": "number"
    },
    "expiry_date": {
      "type": "string",
      "format": "date"
    },
    "retrieved_at": {
      "type": "string",
      "format": "date-time"
    },
    "formula_version": {
      "type": "string"
    },
    "parser_version": {
      "type": "string"
    },
    "validation_status": {
      "enum": [
        "PASS",
        "FLAG"
      ]
    },
    "availability_status": {
      "enum": [
        "AVAILABLE",
        "STALE"
      ]
    }
  }
}
