{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "L4-001 CPI Observation",
  "type": "object",
  "required": [
    "variable_id",
    "observation_date",
    "value",
    "unit",
    "source_series_id",
    "validation_status",
    "availability_status"
  ],
  "properties": {
    "variable_id": {
      "const": "L4-001"
    },
    "observation_date": {
      "type": "string",
      "format": "date"
    },
    "value": {
      "type": "number",
      "minimum": 0
    },
    "unit": {
      "const": "index"
    },
    "source_name": {
      "const": "FRED"
    },
    "source_series_id": {
      "const": "CPIAUCSL"
    },
    "validation_status": {
      "enum": [
        "PASS",
        "FLAG"
      ]
    },
    "availability_status": {
      "enum": [
        "AVAILABLE",
        "STALE"
      ]
    }
  }
}
